{
  // Type-checks the pure battle engine (and the content config it shares types with) WITHOUT
  // the DOM lib, so any use of window, document, performance or timers fails to compile.
  // Run via `npm run typecheck`.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.engine.tsbuildinfo",
    "lib": ["ES2022"],
    "types": [],
    "paths": {}
  },
  "include": ["src/engine/**/*.ts", "src/content/**/*.ts"]
}
