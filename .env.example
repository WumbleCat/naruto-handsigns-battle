# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Settings -> API). The anon/publishable key is safe to ship to the browser;
# all data access is protected by Row Level Security.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Dev-only tools such as /dev/recorder. Always on in `vite dev`; set to "true" to expose them
# in a production build (for example on a Vercel preview deployment).
VITE_ENABLE_DEV_TOOLS=false

# Optional: self-hosted MediaPipe WASM assets. Leave empty to load from the jsDelivr CDN.
VITE_MEDIAPIPE_WASM_URL=
